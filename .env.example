# Copy to .env and adjust for your local setup.
# These values are consumed by docker-compose.yml and the Spring Boot app.

# PostgreSQL
POSTGRES_DB=qarz_mukti
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Backend
DB_URL=jdbc:postgresql://localhost:5432/qarz_mukti
DB_USERNAME=postgres
DB_PASSWORD=postgres
# Use a long random string (>= 32 chars) in any real deployment
JWT_SECRET=dev-only-secret-key-change-me-0123456789abcdef
